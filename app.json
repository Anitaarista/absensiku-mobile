{
  "expo": {
    "name": "AbsensiKu",
    "slug": "absensiku-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0D9488"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyperlot99.absensiku"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D9488"
      },
      "package": "com.hyperlot99.absensiku",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan akses kamera untuk memindai QR Code absensi."
        }
      ],
      [
        "expo-secure-store"
      ],
      "expo-asset",
      "expo-font"
    ],
    "googleServicesFile": "./google-services.json",
    "extra": {
      "apiUrl": "http://localhost:3000/api",
      "eas": {
        "projectId": "be179dec-a9d2-44d6-984a-7b074d209f9c"
      }
    },
    "owner": "hyperlot999"
  }
}
