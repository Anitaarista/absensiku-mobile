{
  "expo": {
    "name": "AbsensiKu",
    "slug": "absensiku-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0D9488"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.absensiku.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D9488"
      },
      "package": "com.absensiku.mobile",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Aplikasi membutuhkan akses kamera untuk memindai QR Code absensi." }],
      ["expo-secure-store"]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api"
    }
  }
}
