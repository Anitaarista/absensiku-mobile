# AbsensiKu Mobile - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL for mobile app (embedded at build time)
# IMPORTANT: This must be a publicly accessible URL for production builds
# Development (Android emulator): http://10.0.2.2:3000/api
# Development (physical device on same network): http://YOUR_LOCAL_IP:3000/api
# Production: https://your-api-domain.com/api
EXPO_PUBLIC_API_URL=https://your-api-domain.com/api

# Backend Server Port
PORT=3000

# Firebase Project Configuration
FIREBASE_PROJECT_ID=gen-lang-client-0173847591
FIREBASE_DATABASE_URL=https://gen-lang-client-0173847591.firebaseio.com

# Firebase Service Account - Option 1: Base64 encoded JSON
# To encode: cat serviceAccountKey.json | base64 -w 0
FIREBASE_CREDENTIAL=

# Firebase Service Account - Option 2: File path
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
