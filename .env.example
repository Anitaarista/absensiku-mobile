# AbsensiKu Mobile - Environment Variables
# Copy this file to .env and fill in your values

# Firebase Configuration
FIREBASE_PROJECT_ID=gen-lang-client-0173847591
FIREBASE_DATABASE_URL=https://gen-lang-client-0173847591.firebaseio.com
# Base64 encoded Firebase service account JSON
# To encode: cat your-service-account.json | base64 -w 0
FIREBASE_CREDENTIAL=

# API URL for mobile app (embedded at build time)
# Development (Android emulator): http://10.0.2.2:3000/api
# Development (iOS simulator): http://localhost:3000/api
# Production: https://your-api-domain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Backend Server Port
PORT=3000
